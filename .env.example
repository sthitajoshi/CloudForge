# Copy to .env and fill in. .env is gitignored; this file is not, so it
# must never carry real values.
#
# Nothing here costs money and no AWS credentials are involved anywhere --
# the Terraform provider authenticates to LocalStack with dummy test/test
# values, which is the whole point of the design.

# ---------------------------------------------------------------------------
# LOCAL ONLY (.env) -- read by docker-compose.yml
# ---------------------------------------------------------------------------

# Genuinely optional -- leave it blank and everything still works.
#
# LocalStack is pinned to 4.9 in docker-compose.yml and in CI. From the
# 2026 releases onward the image refuses to start without a token: it
# exits with code 55 and "License activation failed". 4.9 is the newest
# tag that runs unlicensed, and reports edition "community" with S3,
# DynamoDB, IAM, EC2 and STS available -- everything this project uses.
#
# Only set this if you want Pro features locally, and only after changing
# the pinned image tag. https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# GITHUB ACTIONS SECRETS -- set in the repository, NOT in this file
#   Settings > Secrets and variables > Actions > New repository secret
#   or: gh secret set <NAME> --repo sthitajoshi/CloudForge
# ---------------------------------------------------------------------------

# INFRACOST_API_KEY
#   Required by the `cost` job in .github/workflows/terraform-plan.yml,
#   which posts the monthly cost delta as a PR comment. Free key from
#   https://www.infracost.io -- it reads the Terraform plan file, so it
#   works identically against LocalStack and real AWS.

# GITHUB_TOKEN
#   Do NOT create this. GitHub injects it into every workflow run. Used to
#   push images to GHCR and to post plan and cost comments on PRs.
